@page "/"
@inject IManagementService Management
@inject ICacheEvictionService Eviction
@inject IOptions<ProxyOptions> Options

<PageTitle>127Cache</PageTitle>

<h2>Overview</h2>
<FeedUrl Url="@UiFormat.FeedUrl(Options.Value)" />

@if (_refreshError is not null)
{
    <p role="alert" class="error">Refresh failed: @_refreshError</p>
}
else if (_refreshSummary is not null)
{
    <div role="status" class="notice">
        <p>@(_refreshSummary.Succeeded ? "Refresh finished." : "Refresh finished with errors.")</p>
        <ul class="plain">
            @foreach (var result in _refreshSummary.Sources)
            {
                <li>
                    <strong>@result.Source</strong>:
                    @if (result.Succeeded)
                    {
                        <span>@result.Builds build(s) found</span>
                        @if (result.Coalesced) { <span class="muted"> (joined a refresh already in progress)</span> }
                    }
                    else
                    {
                        <span class="error">failed: @result.Error</span>
                    }
                </li>
            }
        </ul>
    </div>
}

@if (_loadError is not null)
{
    <p role="alert" class="error">Could not read the cache: @_loadError</p>
}
else
{
    <p>Cache size on disk: <strong>@UiFormat.Size(_diskBytes)</strong> in <code>@Options.Value.CacheDirectory</code></p>

    <h2>Sources</h2>
    @if (_sources.Count == 0)
    {
        <p>No sources are configured. <a href="/sources">Add one in source management</a>.</p>
    }
    else
    {
        <form id="refresh-form" method="post" @formname="refresh" @onsubmit="RefreshAsync" data-busy="refresh-status">
            <AntiforgeryToken />
            <button type="submit" name="source" value="" data-busy-label="Refreshing all sources…">Refresh all sources</button>
            <a class="button" href="/remove?scope=closed">Remove closed-PR builds…</a>
            <span id="refresh-status" role="status" class="muted" hidden></span>
        </form>
        <SourcesTable Sources="_sources" Now="_now" />

        <h2>Builds</h2>
        @if (_packagesUnavailable is not null)
        {
            <p role="status" class="muted">Package ids are unavailable right now: @_packagesUnavailable</p>
        }
        <BuildsTable Sources="_sources" Builds="_builds" PackageIds="_packageIds" Now="_now" />
    }
}

@code {
    private IReadOnlyList<SourceInfo> _sources = [];
    private IReadOnlyList<BuildInfo> _builds = [];
    private IReadOnlyDictionary<(string Source, int PullRequest, long RunId, int Attempt), IReadOnlyList<string>> _packageIds
        = new Dictionary<(string, int, long, int), IReadOnlyList<string>>();
    private long _diskBytes;
    private string? _loadError;
    private string? _packagesUnavailable;
    private DateTimeOffset _now;
    private RefreshSummary? _refreshSummary;
    private string? _refreshError;

    [SupplyParameterFromForm(Name = "source")] private string? RefreshSource { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    // On the form post this runs after OnInitializedAsync, so the tables are reloaded to show the refreshed state.
    private async Task RefreshAsync()
    {
        try
        {
            _refreshSummary = await Management.RefreshAsync(string.IsNullOrEmpty(RefreshSource) ? null : RefreshSource);
        }
        catch (Exception exception) when (exception is KeyNotFoundException or IOException or InvalidOperationException)
        {
            _refreshError = exception.Message;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _now = Options.Value.TimeProvider.GetUtcNow();
        _loadError = null;
        _packagesUnavailable = null;
        try
        {
            // Package ids come from the same inventory as the feed, so this can materialize (download) builds. It runs
            // before the builds are listed so a build that was removed and is open again shows as downloaded.
            _packageIds = (await Management.GetPackagesAsync())
                .SelectMany(package => package.Versions.Select(v => (Id: package.Id, Version: v)))
                .GroupBy(x => (x.Version.Source, x.Version.PullRequest, x.Version.RunId, x.Version.Attempt))
                .ToDictionary(x => x.Key, x => (IReadOnlyList<string>)x.Select(y => y.Id).Distinct(StringComparer.OrdinalIgnoreCase)
                    .Order(StringComparer.OrdinalIgnoreCase).ToArray());
        }
        catch (Exception exception) when (exception is DiscoveryUnavailableException or IOException or InvalidOperationException)
        {
            _packagesUnavailable = exception.Message;
        }
        try
        {
            _sources = await Management.GetSourcesAsync();
            _builds = await Management.GetBuildsAsync();
            _diskBytes = (await Eviction.GetDiskUsageAsync()).TotalBytes;
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or UnauthorizedAccessException)
        {
            _loadError = exception.Message;
        }
    }
}
