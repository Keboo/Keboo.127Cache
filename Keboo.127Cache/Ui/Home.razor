@page "/"
@page "/_ui/overview"
@inject OverviewLoader Loader
@inject IOptions<ProxyOptions> Options

<PageTitle>127Cache</PageTitle>

<h2>Overview</h2>
<FeedUrl Url="@UiFormat.FeedUrl(Options.Value)" />
<p id="overview-announcement" role="status" aria-live="polite"></p>
<p id="overview-connection-error" role="alert" hidden>
    Could not update the overview. <button type="button" data-overview-retry>Retry connection</button>
</p>
<noscript><p>Automatic updates need JavaScript. <a href="/">Reload the overview</a> to see background results.</p></noscript>

<section id="overview" data-revision="@_state.Revision" data-busy="@_state.Busy.ToString().ToLowerInvariant()"
         data-status="@_state.Status" aria-busy="@_state.Busy.ToString().ToLowerInvariant()">
    <p class="@(_state.Busy ? "loading" : null)">@_state.Status</p>
    @if (_state.Error is not null)
    {
        <p role="alert" class="error">Could not update the overview: @_state.Error</p>
    }
    @if (_state.Refresh is { } summary)
    {
        <ul class="plain">
            @foreach (var result in summary.Sources)
            {
                <li><strong>@result.Source</strong>:
                    @if (result.Succeeded)
                    {
                        <span>@result.Builds build(s) found</span>
                        @if (result.Coalesced) { <span class="muted"> (joined a refresh already in progress)</span> }
                    }
                    else
                    {
                        <span class="error">failed: @result.Error</span>
                    }
                </li>
            }
        </ul>
    }
    <form id="refresh-form" method="post" action="/" @formname="refresh" @onsubmit="Refresh" data-overview-refresh>
        <AntiforgeryToken />
        <button type="submit" name="source" value="" disabled="@_state.Busy">Refresh all sources / retry</button>
        <a class="button" href="/remove?scope=closed">Remove closed-PR builds…</a>
    </form>

    <p>Cache size on disk:
        @if (_state.DiskBytes is { } bytes)
        {
            <strong>@UiFormat.Size(bytes)</strong>
        }
        else
        {
            <span class="@(_state.Busy ? "loading" : "muted")">@(_state.Busy ? "Scanning…" : "Unavailable")</span>
        }
        in <code>@Options.Value.CacheDirectory</code>
    </p>
    <h2>Sources</h2>
    @if (_state.Sources is null)
    {
        <p class="@(_state.Busy ? "loading" : "muted")">@(_state.Busy ? "Loading sources…" : "Sources unavailable.")</p>
    }
    else if (_state.Sources.Count == 0)
    {
        <p>No sources are configured. <a href="/sources">Add one in source management</a>.</p>
    }
    else
    {
        <SourcesTable Sources="_state.Sources" Now="_now" RefreshDisabled="_state.Busy" />
        <h2>Builds</h2>
        @if (_state.Builds is null)
        {
            <p class="@(_state.Busy ? "loading" : "muted")">@(_state.Busy ? "Discovering completed builds…" : "Builds unavailable.")</p>
        }
        else
        {
            <BuildsTable Sources="_state.Sources" Builds="_state.Builds" PackageIds="_state.PackageIds" Now="_now" />
        }
    }
</section>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromForm(Name = "source")] private string? RefreshSource { get; set; }
    private OverviewState _state = new();
    private DateTimeOffset _now;

    protected override void OnInitialized()
    {
        if (HttpContext is { Request.Method: "GET", Request.Path.Value: "/" }) Loader.Load();
        ReadState();
    }

    private void Refresh()
    {
        Loader.Load(refresh: true, source: string.IsNullOrEmpty(RefreshSource) ? null : RefreshSource);
        ReadState();
    }

    private void ReadState()
    {
        _state = Loader.State;
        _now = Options.Value.TimeProvider.GetUtcNow();
    }
}
