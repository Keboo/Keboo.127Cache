<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Moq.AutoMock" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="TUnit.Assertions" />
    <PackageReference Include="TUnit.Engine" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="FakeGh\**\*.cs" />
    <ProjectReference Include="..\Keboo.127Cache\Keboo.127Cache.csproj" />
    <ProjectReference Include="FakeGh\FakeGh.csproj" ReferenceOutputAssembly="false" />
    <None Update="Fixtures\ReleasedMain-7625362.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="FlockFaultInjection.c" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Assertions" />
    <Using Include="TUnit.Assertions.Extensions" />
    <Using Include="TUnit.Core" />
    <Using Include="Moq" />
    <Using Include="Moq.AutoMock" />
  </ItemGroup>

  <Target Name="CopyFakeGh" AfterTargets="Build">
    <ItemGroup>
      <FakeGhFiles Include="$(MSBuildProjectDirectory)\FakeGh\bin\$(Configuration)\net10.0\gh*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeGhFiles)" DestinationFolder="$(OutDir)fake-gh" />
  </Target>

</Project>
